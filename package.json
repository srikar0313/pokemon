{
  "name": "pokemon",
  "version": "1.0.0",
  "main": "backend/server.js",
  "scripts": {
    "postinstall": "prisma generate",
    "start": "node backend/server.js",
    "validate": "node scripts/validateData.js",
    "smoke": "node scripts/smokeTest.js",
    "test": "npm run cries:build && npm run validate && npm run smoke && npm run persistence:test && npm run obtainability:audit && npm run presentation:test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:import-legacy": "node scripts/importLegacySaves.js",
    "persistence:test": "node scripts/persistenceTest.js",
    "cries:build": "node scripts/buildCryManifest.js",
    "presentation:test": "node scripts/presentationTest.mjs",
    "obtainability:build": "node scripts/generateObtainability.js",
    "obtainability:audit": "node scripts/auditObtainability.js",
    "pokemon:add": "node scripts/addPokemon.js",
    "pokeapi:audit": "node scripts/auditPokeApi.js",
    "pokeapi:build": "node scripts/buildCanonicalPokemonData.js && node scripts/generateObtainability.js"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "dotenv": "^17.2.2",
    "express": "^4.18.2",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "prisma": "^6.16.2"
  }
}
